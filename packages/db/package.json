{
  "name": "@cio-agent/db",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "seed": "tsx src/seeds/dev.ts",
    "test:unit": "jest --testPathPattern='(?<!rls)\\.test\\.ts$'",
    "test:integration": "TEST_TYPE=integration jest --testPathPattern='rls\\.test\\.ts$'",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "drizzle-orm": "^0.41.0",
    "pg": "^8.13.3",
    "@types/pg": "^8.11.14"
  },
  "devDependencies": {
    "@cio-agent/tsconfig": "*",
    "@cio-agent/eslint-config": "*",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14"
  }
}
