# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001

# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── PostgreSQL — Main DB ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cio_agent
POSTGRES_USER=cio_agent_app
POSTGRES_PASSWORD=change_me
POSTGRES_SSL=false

# ─── PostgreSQL — Audit DB ─────────────────────────────────────────────────────
AUDIT_POSTGRES_HOST=localhost
AUDIT_POSTGRES_PORT=5433
AUDIT_POSTGRES_DB=cio_agent_audit
AUDIT_POSTGRES_USER=cio_agent_audit_app
AUDIT_POSTGRES_PASSWORD=change_me

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# ─── HashiCorp Vault ───────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT_PATH=secret/cioagent

# ─── JWT ───────────────────────────────────────────────────────────────────────
# RSA-256 keys — injected via Vault in production, file paths for local dev only
JWT_PRIVATE_KEY_PATH=./keys/jwt.private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt.public.pem
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── LLM Providers ─────────────────────────────────────────────────────────────
# Customer-owned keys — entered per tenant via AgentMetric Studio
# Stored encrypted in Vault, never in this file for production
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=gsk_PLACEHOLDER
AZURE_OPENAI_API_KEY=PLACEHOLDER
AZURE_OPENAI_ENDPOINT=https://PLACEHOLDER.openai.azure.com

# ─── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-PLACEHOLDER
LANGFUSE_SECRET_KEY=sk-lf-PLACEHOLDER
LANGFUSE_BASE_URL=http://localhost:3000

# ─── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=change_me
KIBANA_PORT=5601
GRAFANA_TEMPO_PORT=3200

# ─── Connectors ────────────────────────────────────────────────────────────────
# All connector credentials are stored in Vault per tenant — not here
# These are used only for local dev mock connector
MOCK_CONNECTOR_ENABLED=true
