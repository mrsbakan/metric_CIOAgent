{
  "_comment": "Elasticsearch ILM policies. Apply via: curl -X PUT http://localhost:9200/_ilm/policy/<name> -H 'Content-Type: application/json' -d @ilm-policies.json",

  "policies": {
    "cio-agent-app-logs": {
      "policy": {
        "phases": {
          "hot": {
            "min_age": "0ms",
            "actions": {
              "rollover": { "max_age": "7d", "max_size": "10gb" },
              "set_priority": { "priority": 100 }
            }
          },
          "warm": {
            "min_age": "30d",
            "actions": {
              "shrink": { "number_of_shards": 1 },
              "forcemerge": { "max_num_segments": 1 },
              "set_priority": { "priority": 50 }
            }
          },
          "delete": {
            "min_age": "90d",
            "actions": { "delete": {} }
          }
        }
      }
    },

    "cio-audit-logs": {
      "policy": {
        "phases": {
          "hot": {
            "min_age": "0ms",
            "actions": {
              "rollover": { "max_age": "30d", "max_size": "20gb" },
              "set_priority": { "priority": 100 }
            }
          },
          "warm": {
            "min_age": "90d",
            "actions": {
              "shrink": { "number_of_shards": 1 },
              "forcemerge": { "max_num_segments": 1 },
              "set_priority": { "priority": 50 }
            }
          },
          "cold": {
            "min_age": "365d",
            "actions": {
              "freeze": {},
              "set_priority": { "priority": 0 }
            }
          },
          "delete": {
            "min_age": "730d",
            "actions": { "delete": {} }
          }
        }
      }
    }
  }
}
